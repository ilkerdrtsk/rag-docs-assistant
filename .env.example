# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:5432/rag

# Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Optional: semantic (vector) search with Voyage AI embeddings. Without it, keyword search only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Optional: require an X-API-Key header on every request
API_KEY=

# Host ports used by docker compose
POSTGRES_PORT=5432
API_PORT=8000
